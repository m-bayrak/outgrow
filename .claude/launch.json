{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "outgrow-claude-studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "projects/outgrow/src/claude",
        "exec",
        "remotion",
        "studio",
        "src/index.ts",
        "--no-open",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "--directory",
        "docs"
      ],
      "port": 4180
    }
  ]
}
